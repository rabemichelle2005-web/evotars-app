# Railway environment variables for this fork
#
# This file is a reference only - it is never read by the app. Enter these
# as Service Variables in the Railway dashboard for each service. Replace
# <public-domain> with the domain Railway (or your custom domain) gives the
# "nginx" service's public networking - generate that domain FIRST, before
# setting the variables below or deploying "api", since several values
# (VITE_*, HOST*, ADMIN_URL, CLIENT_URL, TWITCH_CALLBACK_URL) are derived
# from it.
#
# Never commit a real, filled-in copy of this file.

# ============================================================
# Postgres (Railway managed plugin - "Postgres" service)
# ============================================================
# Created automatically when you add a "Postgres" database plugin in
# Railway. Nothing to enter here - other services reference it (see below).

# ============================================================
# "api" service - railway/api.Dockerfile
# ============================================================

# Runtime (used by the Nest app at boot; NOT build args)
PORT=3000
HOST=<public-domain>
HOST_URL=https://<public-domain>
ADMIN_URL=https://<public-domain>/admin
CLIENT_URL=https://<public-domain>/client

# Twitch Developer Console credentials for YOUR Twitch application
# (see twitch-console step below - do not reuse Inferst's evotars.inferst.com app)
TWITCH_CLIENT_ID=<your-twitch-client-id>
TWITCH_CLIENT_SECRET=<your-twitch-client-secret>
# Any random string you generate yourself, used to verify EventSub webhook signatures
TWITCH_WEBHOOK_SECRET=<generate-a-random-secret>
TWITCH_CALLBACK_URL=https://<public-domain>/api/auth/callback

# Any random string you generate yourself, used to sign session cookies
SESSION_SECRET=<generate-a-random-secret>

# Railway Postgres reference variable - use Railway's variable reference
# picker (or type it manually) to point at the Postgres plugin's own
# DATABASE_URL, e.g.:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Build args (Railway auto-injects any Service Variable whose name matches
# a Dockerfile ARG - these are baked into the admin/client browser bundles
# at build time, so they MUST be your own public domain, never
# evotars.inferst.com)
VITE_API_URL=https://<public-domain>/api
VITE_CLIENT_SOCKET_HOST=https://<public-domain>
VITE_CJS_IGNORE_WARNING=true

# Optional: only set this if you want errors sent to YOUR OWN Sentry
# project. apps/api/src/instruments.ts has Inferst's Sentry DSN hardcoded,
# but it only sends events when SENTRY_ENVIRONMENT is exactly "production"
# - leave this unset (or anything other than "production") on Railway so
# nothing is ever sent to Inferst's Sentry project.
# SENTRY_ENVIRONMENT=production

# ============================================================
# "website" service - railway/website.Dockerfile
# ============================================================
PORT=3000

# ============================================================
# "nginx" service - railway/nginx.Dockerfile (public gateway)
# ============================================================
# Fixed port nginx listens on inside the container - set the same value as
# the "Target Port" when you generate this service's public domain.
PORT=8080

# Railway private-networking reference variables pointing at the other two
# services (use Railway's variable reference picker, or type manually with
# the exact service names you used when creating them):
API_HOST=${{api.RAILWAY_PRIVATE_DOMAIN}}
WEBSITE_HOST=${{website.RAILWAY_PRIVATE_DOMAIN}}
